{
    "schemaVersion": 1,
    "id": "${aci_mod_id}",
    "version": "${aci_version}",
    "name": "${aci_mod_name}",
    "description": "${aci_description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "issues": "https://github.com/yanny7/advancedlootinfo/issues",
        "sources": "https://github.com/yanny7/advancedlootinfo"
    },
    "license": "${license}",
    "icon": "logo.png",
    "environment": "*",
    "entrypoints": {
        "fabric-datagen": [
            "com.yanny.aci.fabric.datagen.DataGeneration"
        ]
    },
    "depends": {
        "fabricloader": "*",
        "fabric-api": "*",
        "minecraft": "${minecraft_version}",
        "java": ">=${java_version}"
    }
}
